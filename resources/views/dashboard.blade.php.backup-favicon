<script>
document.addEventListener('DOMContentLoaded', () => {
    const html = document.documentElement;
    const fr = document.getElementById('lang-fr');
    const ar = document.getElementById('lang-ar');

    function setLanguage(language) {
        const isArabic = language === 'ar';

        html.dataset.lang = isArabic ? 'ar' : 'fr';
        html.dir = isArabic ? 'rtl' : 'ltr';
        html.lang = isArabic ? 'ar' : 'fr';

        ar.classList.toggle('on', isArabic);
        fr.classList.toggle('on', !isArabic);

        try {
            localStorage.setItem('etude_lang', isArabic ? 'ar' : 'fr');
        } catch (error) {
            // La langue fonctionne même si localStorage est indisponible.
        }
    }

    let savedLanguage = 'fr';

    try {
        savedLanguage = localStorage.getItem('etude_lang') || 'fr';
    } catch (error) {}

    setLanguage(savedLanguage);

    fr.addEventListener('click', () => setLanguage('fr'));
    ar.addEventListener('click', () => setLanguage('ar'));

    const cards = document.querySelectorAll('[data-status]');
    const emptyMessage = document.getElementById('filterEmpty');
    const filterButtons = document.querySelectorAll('[data-filter]');

    filterButtons.forEach(button => {
        button.addEventListener('click', () => {
            filterButtons.forEach(item => item.classList.remove('on'));
            button.classList.add('on');

            let visibleCount = 0;

            cards.forEach(card => {
                const filter = button.dataset.filter;

                const matches =
                    filter === 'all' ||
                    card.dataset.status === filter;

                card.style.display = matches ? '' : 'none';

                if (matches) visibleCount++;
            });

            if (emptyMessage) {
                emptyMessage.classList.toggle('hidden', visibleCount > 0);
            }
        });
    });
});
</script>

